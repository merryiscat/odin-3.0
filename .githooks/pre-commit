#!/bin/sh
# kickoff-workspaces v0.5.0 (관리 파일 — 플러그인에서 갱신)
# 기획 브랜치 가드 (kickoff-workspaces) — pl 워크트리에서는 docs/ 밖 파일을 커밋할 수 없다.
# 판정은 브랜치 마지막 세그먼트: pl, pl-<주제> (Orca가 <git-username>/pl 꼴로 만든다)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
leaf=${branch##*/}
case "$leaf" in
  pl|pl-*) ;;
  *) exit 0 ;;
esac
bad=$(git diff --cached --name-only --diff-filter=ACMRD | grep -v '^docs/')
if [ -n "$bad" ]; then
  echo "[pl guard] 기획 브랜치($branch)에서는 docs/ 밖 파일을 커밋할 수 없다:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "구현은 스펙(docs/tasks/)을 승인받아 워커 워크트리에서 한다." >&2
  exit 1
fi
exit 0
