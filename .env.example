# 오딘 3.0 — 환경변수 템플릿 (data_pipeline)
# 이 파일(.env.example)은 "값 없는 예시"라 커밋해도 됩니다.
# 실제 값이 든 .env 는 절대 커밋 금지(.gitignore가 이미 막음). 각자 컴퓨터에만 둡니다.
#
# 채우는 법: PowerShell에서  .\scripts\setup-keys.cmd  를 실행하면 대화식으로 안내합니다.

# DART 전자공시 OpenAPI 인증키 — https://opendart.fss.or.kr/ (인증키 신청/관리)
# 용도: 회사정보·재무·공시·기업코드(corpCode.xml)
DART_API_KEY=

# 공공데이터포털(data.go.kr) 금융위 서비스키 — 종목 마스터·시세(dim_stock 채우기)
# 활용신청: '금융위원회 KRX상장종목정보' + '금융위원회 주식시세정보'
DATA_GO_KR_KEY=

# KRX Data Marketplace 인증키 — https://openapi.krx.co.kr/
# 용도: 시장 통계·일별 매매정보(state_module·분석용). data.go.kr와는 다른 키.
KRX_API_KEY=

# 새 3.0 Supabase 접속정보 — 대시보드 > Settings > API Keys
# SUPABASE_SERVICE_KEY = 'Secret key'(sb_secret_..., 서버 전용·RLS 우회). 옛 service_role도 가능.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 공개 읽기 키(anon/publishable) — 쓰기 없는 --dry-run·검증 스크립트용. odin_gui에 이미 공개된 값과 같음.
SUPABASE_ANON_KEY=

# 한국투자증권(KIS) OpenAPI — 실시간 1분 수집(data_pipeline/collect_rt.py). 시세 조회만, 주문 안 함.
# 3.0 오픈 전까지는 옛 오딘과 같은 실전 앱키를 그대로 씀(2026-09-14 결정 — 호출량 하루 ~1,560건).
KIS_APP_KEY=
KIS_APP_SECRET=
